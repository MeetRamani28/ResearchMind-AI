# ResearchMind-AI Backend Environment Settings

# Environment Mode: "development" or "production"
ENV_MODE=development
DEBUG=True
FRONTEND_URL=http://localhost:5173

# Database URLs
# Development Mode uses local SQLite
DEV_DATABASE_URL=sqlite+aiosqlite:///./researchmind_dev.db

# Production Mode uses Supabase PostgreSQL
PROD_DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_supabase_project.supabase.co:5432/postgres

# AI API Keys
COHERE_API_KEY=your_cohere_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Clerk Authentication Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# Production Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=researchmind-index
